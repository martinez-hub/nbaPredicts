<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.martinez-hub.nbapredicts-textlog</string>
  <!-- ESPN's injury notes and news, logged every hour: ESPN's text stays off
       the public repo, so the daily workflow no longer logs it. launchd jobs
       may not read the external SSD (macOS: "Operation not permitted"), so
       this runs from the internal disk: a small venv with pandas, requests
       and this package, installed without its other dependencies (reinstall
       it the same way after text_log.py changes). It writes to
       ~/.local/share/nbapredicts/data_local, which the repo's
       data_local/text_news and data_local/text_injuries link to. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/josuemartinez/.venvs/nbapredicts-textlog/bin/nbapredicts</string>
    <string>--root</string>
    <string>/Users/josuemartinez/.local/share/nbapredicts</string>
    <string>text-log</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/josuemartinez</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-textlog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-textlog.log</string>
</dict>
</plist>
