<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.martinez-hub.nbapredicts-dispatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/josuemartinez/.local/bin/nbapredicts-dispatch.sh</string>
  </array>
  <!-- Local (Eastern) time. 6:45 AM: last night's games are final; 5:50 PM:
       the afternoon injury report; 7:15 PM: before the later tip-offs. A slot
       missed while the Mac sleeps runs on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>45</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>17</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>19</integer>
      <key>Minute</key>
      <integer>15</integer>
    </dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/josuemartinez</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-dispatch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-dispatch.log</string>
</dict>
</plist>
