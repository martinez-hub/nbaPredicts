<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.martinez-hub.nbapredicts-refresh</string>
  <!-- Daily refresh of the local data archives (scripts/refresh_all.py) at
       5:30 AM local time, before the 6:45 dispatch. It runs through the
       "nbaPredicts Refresh" app (~/Applications/nbaPredictsRefresh.app: a
       copy of Python signed under its own bundle id), the one program the
       owner allows to reach the external SSD; the repo's venv supplies the
       packages. A day missed while the Mac sleeps runs on wake. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/josuemartinez/Applications/nbaPredictsRefresh.app/Contents/MacOS/nbapredicts-refresh</string>
    <string>/Volumes/ExtremeSSD/nbaPredicts/scripts/refresh_all.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/josuemartinez</string>
    <key>PYTHONPATH</key>
    <string>/Volumes/ExtremeSSD/nbaPredicts/src:/Volumes/ExtremeSSD/nbaPredicts/.venv/lib/python3.12/site-packages</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josuemartinez/Library/Logs/nbapredicts-refresh.log</string>
</dict>
</plist>
